<Page x:Class="SimpleAccounting.Pages.ProductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Товары">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="📦 Товары" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

            <Button Content="➕ Добавить" 
                    Width="120" Height="35"
                    Margin="0,0,10,0"
                    Click="AddProduct_Click"/>

            <Button Content="✏️ Редактировать" 
                    Width="160" Height="35"
                    Margin="0,0,10,0"
                    Click="EditProduct_Click"/>

            <Button Content="🗑️ Удалить" 
                    Width="120" Height="35"
                    Click="DeleteProduct_Click"/>
        </StackPanel>

        <!-- Таблица товаров -->
        <DataGrid Grid.Row="1" 
                  x:Name="ProductsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Цена (руб.)" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="120"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>