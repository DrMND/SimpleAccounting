<Page x:Class="SimpleAccounting.Pages.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Сотрудники">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="👨‍💼 Сотрудники" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

            <Button Content="➕ Добавить" 
                    Width="120" Height="35"
                    Margin="0,0,10,0"
                    Click="AddEmployee_Click"/>

            <Button Content="✏️ Редактировать" 
                    Width="160" Height="35"
                    Margin="0,0,10,0"
                    Click="EditEmployee_Click"/>

            <Button Content="🗑️ Удалить" 
                    Width="120" Height="35"
                    Click="DeleteEmployee_Click"/>
        </StackPanel>

        <!-- Таблица сотрудников -->
        <DataGrid Grid.Row="1" 
                  x:Name="EmployeesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="200"/>
                <DataGridTextColumn Header="Оклад (руб.)" Binding="{Binding Salary, StringFormat={}{0:N2} ₽}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>