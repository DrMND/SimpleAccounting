<Page x:Class="SimpleAccounting.Pages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Пользователи">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и кнопки -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="👤 Пользователи" 
                       FontSize="24" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

            <Button Content="➕ Добавить" 
                    Width="120" Height="35"
                    Margin="0,0,10,0"
                    Click="AddUser_Click"/>

            <Button Content="✏️ Редактировать" 
                    Width="120" Height="35"
                    Margin="0,0,10,0"
                    Click="EditUser_Click"/>

            <Button Content="🗑️ Удалить" 
                    Width="120" Height="35"
                    Click="DeleteUser_Click"/>
        </StackPanel>

        <!-- Таблица пользователей -->
        <DataGrid Grid.Row="1" 
                  x:Name="UsersGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="150"/>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Роль" Binding="{Binding Role}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>