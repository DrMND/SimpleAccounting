<Page x:Class="SimpleAccounting.Pages.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      Title="Отчёты">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📊 Отчёты" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,30"
                   HorizontalAlignment="Center"/>

        <!-- Кнопки отчётов (центрированные) -->
        <StackPanel Grid.Row="1" 
                    VerticalAlignment="Top" 
                    HorizontalAlignment="Center">

            <Button Content="📦 Остатки на складе" 
                    Width="350" Height="60"
                    Margin="0,0,0,20"
                    FontSize="18"
                    Click="InventoryReport_Click"/>

            <Button Content="📈 Продажи за период" 
                    Width="350" Height="60"
                    Margin="0,0,0,20"
                    FontSize="18"
                    Click="SalesReport_Click"/>

            <Button Content="💰 Прибыль/убытки" 
                    Width="350" Height="60"
                    Margin="0,0,0,20"
                    FontSize="18"
                    Click="ProfitReport_Click"/>
        </StackPanel>
    </Grid>
</Page>