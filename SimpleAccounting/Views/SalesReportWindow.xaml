<Window x:Class="SimpleAccounting.Views.SalesReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Отчёт: Продажи за период" 
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📈 Продажи за период" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Выбор периода -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="С:" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <DatePicker x:Name="StartDatePicker"
                        Width="150"
                        materialDesign:HintAssist.Hint="Дата начала"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,20,0"
                        FontSize="14"/>

            <TextBlock Text="По:" 
                       FontSize="16" 
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"/>

            <DatePicker x:Name="EndDatePicker"
                        Width="150"
                        materialDesign:HintAssist.Hint="Дата окончания"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,20,0"
                        FontSize="14"/>

            <Button Content="📊 Сформировать" 
                    Width="150" Height="35"
                    Click="GenerateReport_Click"/>
        </StackPanel>

        <!-- Таблица продаж -->
        <DataGrid Grid.Row="2" 
                  x:Name="SalesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
                <DataGridTextColumn Header="Клиент" Binding="{Binding ClientFullName}" Width="*"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalAmount, StringFormat={}{0:N2} ₽}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итоговая строка -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="Итого продаж: " 
               FontSize="18" 
               FontWeight="Bold"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

            <TextBlock x:Name="TotalSalesText" 
               FontSize="18" 
               FontWeight="Bold"
               Foreground="#7E57C2"
               VerticalAlignment="Center"
               Margin="0,0,20,0"/>

            <Button Content="💾 Сохранить" 
            Width="120" Height="35"
            Click="SaveReport_Click"/>
        </StackPanel>
    </Grid>
</Window>