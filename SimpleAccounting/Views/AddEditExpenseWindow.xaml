<Window x:Class="SimpleAccounting.Views.AddEditExpenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Расход" 
        Height="475" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleText"
                   Text="Добавление расхода" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <DatePicker x:Name="DatePicker"
                        materialDesign:HintAssist.Hint="Дата *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,15"
                        FontSize="16"/>

            <TextBox x:Name="CategoryTextBox"
                     materialDesign:HintAssist.Hint="Категория * (например, Аренда, Зарплата, Закупка)"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15"
                     FontSize="16"/>

            <TextBox x:Name="AmountTextBox"
                     materialDesign:HintAssist.Hint="Сумма (руб.) *"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15"
                     FontSize="16"
                     PreviewTextInput="Number_PreviewTextInput"/>

            <TextBox x:Name="DescriptionTextBox"
                     materialDesign:HintAssist.Hint="Описание (необязательно)"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15"
                     FontSize="16"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Height="80"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Width="100" Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить" 
                    Width="120" Height="35"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>