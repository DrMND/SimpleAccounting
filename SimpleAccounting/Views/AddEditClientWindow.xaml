<Window x:Class="SimpleAccounting.Views.AddEditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Клиент" 
        Height="450" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   x:Name="TitleText"
                   Text="Добавление клиента" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <TextBox x:Name="FullNameTextBox"
             materialDesign:HintAssist.Hint="ФИО / Название организации *"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             Margin="0,0,0,15"
             FontSize="16"/>

            <TextBox x:Name="PhoneTextBox"
             materialDesign:HintAssist.Hint="Телефон * (11 цифр, например 89991234567)"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             Margin="0,0,0,15"
             FontSize="16"
             MaxLength="11"
             PreviewTextInput="Phone_PreviewTextInput"/>

            <TextBox x:Name="EmailTextBox"
             materialDesign:HintAssist.Hint="Email * (например user@example.com)"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             Margin="0,0,0,15"
             FontSize="16"/>

            <TextBox x:Name="INNTextBox"
             materialDesign:HintAssist.Hint="ИНН * (10 или 12 цифр)"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             Margin="0,0,0,15"
             FontSize="16"
             MaxLength="12"
             PreviewTextInput="INN_PreviewTextInput"/>

            <TextBox x:Name="AddressTextBox"
             materialDesign:HintAssist.Hint="Адрес (необязательно)"
             Style="{StaticResource MaterialDesignFloatingHintTextBox}"
             Margin="0,0,0,15"
             FontSize="16"/>
        </StackPanel>
        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Width="100" Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить" 
                    Width="120" Height="35"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>