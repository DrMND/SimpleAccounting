<Window x:Class="SimpleAccounting.Views.InventoryReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Отчёт: Остатки на складе" 
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📦 Остатки на складе" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Таблица товаров -->
        <DataGrid Grid.Row="1" 
                  x:Name="InventoryGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="150"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="120"/>
                <DataGridTextColumn Header="Остаток (шт.)" Binding="{Binding Quantity}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalValue, StringFormat={}{0:N2} ₽}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Итоговая строка -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="Итого на складе: " 
               FontSize="18" 
               FontWeight="Bold"
               VerticalAlignment="Center"
               Margin="0,0,10,0"/>

            <TextBlock x:Name="TotalAmountText" 
               FontSize="18" 
               FontWeight="Bold"
               Foreground="#7E57C2"
               VerticalAlignment="Center"
               Margin="0,0,20,0"/>

            <Button Content="💾 Сохранить" 
            Width="140" Height="35"
            Click="SaveReport_Click"/>
        </StackPanel>
    </Grid>
</Window>