<Window x:Class="SimpleAccounting.Views.AddSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Оформление продажи" 
        Height="600" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="📈 Новая продажа" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>

        <!-- Поля ввода -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <DatePicker x:Name="DatePicker"
                        materialDesign:HintAssist.Hint="Дата *"
                        Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,15"
                        FontSize="16"/>

            <TextBlock Text="Клиент *" 
                       FontSize="14" 
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="ClientComboBox"
                      DisplayMemberPath="FullName"
                      materialDesign:HintAssist.Hint="Выберите клиента"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,15"
                      FontSize="16"/>

            <TextBlock Text="Товар *" 
                       FontSize="14" 
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="ProductComboBox"
                      DisplayMemberPath="Name"
                      materialDesign:HintAssist.Hint="Выберите товар"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,15"
                      FontSize="16"/>

            <TextBox x:Name="QuantityTextBox"
                     materialDesign:HintAssist.Hint="Количество *"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15"
                     FontSize="16"
                     PreviewTextInput="Number_PreviewTextInput"/>

            <TextBox x:Name="AmountTextBox"
                     materialDesign:HintAssist.Hint="Общая сумма (руб.) *"
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}"
                     Margin="0,0,0,15"
                     FontSize="16"
                     PreviewTextInput="Number_PreviewTextInput"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" 
                    Width="100" Height="35"
                    Margin="0,0,10,0"
                    Click="Cancel_Click"/>

            <Button Content="Сохранить" 
                    Width="120" Height="35"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>